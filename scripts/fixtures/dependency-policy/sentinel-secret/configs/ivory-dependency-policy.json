{
  "policyVersion": "1",
  "licenseClasses": {
    "allowed": [
      "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
      "MIT",
      "Apache-2.0",
      "ISC"
    ],
    "reviewRequired": [
      "LGPL-2.1+",
      "CC-BY-4.0"
    ],
    "prohibited": [
      "GPL-3.0-only",
      "AGPL-3.0-only",
      "UNLICENSED"
    ]
  },
  "defaults": {
    "unknownLicense": "deny",
    "networkCapable": "deny",
    "versionPolicy": "exact",
    "uninventoriedDirectDependency": "deny"
  },
  "qualityScope": {
    "packageNamePatterns": [
      "@ivory-tower/*",
      "@theia/ivory-*"
    ],
    "requiredScripts": [
      "format:check:ivory-tower",
      "typecheck:ivory-tower",
      "lint:ivory-tower",
      "test:ivory-tower",
      "dependency:policy"
    ]
  },
  "deployables": {},
  "packages": {
    "wrapper-lib": {
      "allowed": true,
      "scope": "fixture",
      "purpose": "Fixture dependency standing in for an ordinary permissive library.",
      "owner": "Engineering",
      "license": "MIT",
      "networkCapable": false,
      "native": false,
      "dataBoundary": "none",
      "sourceContentCrossesBoundary": false,
      "versionPolicy": "exact",
      "replacementPath": "n/a (fixture)"
    }
  },
  "images": {},
  "mutableTagPatterns": [
    "latest",
    "main",
    "master",
    "edge",
    "stable",
    "dev",
    "nightly"
  ],
  "secretScan": {
    "sentinel": "FIXTURE_SENTINEL_DO_NOT_COMMIT_0a1b2c3d4e",
    "localDevelopmentPasswords": [
      "ivory",
      "ivory-development-only"
    ],
    "criticalPatterns": [
      "sentinel",
      "aws-access-key",
      "private-key",
      "github-token",
      "sentry-dsn"
    ],
    "scanPaths": [
      "**"
    ],
    "allowlist": [
      {
        "path": "configs/ivory-dependency-policy.json",
        "reason": "Declares the sentinel value that the scanner searches for.",
        "owner": "Engineering",
        "patterns": [
          "sentinel"
        ]
      }
    ],
    "note": "Fixtures declare their own sentinel so the repository sentinel never appears in this tree."
  },
  "dataTerms": {
    "modelAssets": [],
    "scholarlyDataTerms": []
  },
  "exceptions": [],
  "advisoryExceptions": []
}
