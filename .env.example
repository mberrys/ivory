# Ivory Tower environment (IV-15 scaffold)
# Copy to .env and adjust for local development.

NODE_ENV=development
IVORY_TOWER_ENV=local
IVORY_DEPLOYMENT_TOPOLOGY=vendorHosted
DATABASE_URL=postgres://ivory:ivory@localhost:5432/ivory_tower
PORT=4100
DOCLING_ENDPOINT=http://localhost:5001
DOCLING_IMAGE=quay.io/docling-project/docling-serve:v1.21.0@sha256:32b3de41f325f93c1dd35907cd9147fa35df9f7c5abc86eb2788b6bda7ce6d10
IVORY_API_BASE_URL=http://localhost:4100
IVORY_OBJECT_STORE_DIR=.ivory-tower/objects
# Hosted profile: set IVORY_S3_BUCKET to use S3/MinIO instead of the local filesystem adapter.
IVORY_S3_BUCKET=
IVORY_S3_ENDPOINT=
IVORY_S3_REGION=us-east-1
IVORY_S3_ACCESS_KEY_ID=
IVORY_S3_SECRET_ACCESS_KEY=
IVORY_S3_FORCE_PATH_STYLE=true
# Comma-separated approved V1 license identifiers, for example CC-BY-4.0,CC0-1.0.
IVORY_APPROVED_LICENSES=

# Optional observability (see README "Observability (Sentry)")
SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
