{
  "schema": "ivory-v41-owner-map/1",
  "issue": "V41-I01.2",
  "dependsOn": "V41-I01.1",
  "basisManifest": "configs/ivory-v41-authority-heads.json",
  "authorityBoundaries": {
    "core": {
      "semanticAuthority": true,
      "responsibilities": [
        "canonical research revisions",
        "exact references",
        "snapshots",
        "research decisions through typed Activity/receipt carriers"
      ]
    },
    "harness": {
      "semanticAuthority": false,
      "responsibilities": [
        "runs",
        "tool and provider routing",
        "permissions",
        "immutable execution traces",
        "evaluation and replay orchestration"
      ],
      "forbidden": [
        "accept research meaning",
        "write canonical research state from workers",
        "infer human approval from machine success"
      ]
    },
    "clients": {
      "semanticAuthority": false,
      "responsibilities": [
        "render snapshot-scoped reads",
        "submit commands and researcher decisions"
      ],
      "forbidden": [
        "adjudicate locally",
        "substitute latest head",
        "persist a second research store"
      ]
    },
    "recursiveImprovement": {
      "semanticAuthority": false,
      "researchStateSeparatedFromImprovementState": true,
      "mayEvolve": [
        "skills",
        "prompts",
        "tool strategy",
        "exploration/orchestration policy",
        "reflection policy"
      ],
      "mayMutateCore": false,
      "protected": [
        "Core evidence semantics",
        "provenance",
        "evaluation standards",
        "researcher authority",
        "acceptance rules",
        "rollback and regression fixtures"
      ]
    }
  },
  "surfaces": [
    {
      "canonicalKey": "Source",
      "owner": "@ivory-tower/research-kernel",
      "carrier": "packages/ivory-tower-research-kernel/src/node/types.ts#SourcePayload",
      "secondary": [
        "@ivory-tower/adapters#SourceRecordPort"
      ],
      "missingFields": [
        "scholarly alias/version assertions",
        "source-status assertion history"
      ]
    },
    {
      "canonicalKey": "Fragment",
      "owner": "@ivory-tower/research-kernel",
