{
  "private": true,
  "name": "@ivory-tower/n5-browser",
  "version": "0.1.0",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "theia": {
    "frontend": {
      "config": {
        "applicationName": "Ivory Tower N5",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "extensions.autoUpdate": false,
          "extensions.autoCheckUpdates": false,
          "python.languageServer": "None"
        },
        "reloadOnReconnect": true
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": 3000
      }
    }
  },
  "dependencies": {
    "@theia/core": "1.74.0",
    "@theia/filesystem": "1.74.0",
    "@theia/messages": "1.74.0",
    "@theia/preferences": "1.74.0",
    "@theia/process": "1.74.0",
    "@theia/workspace": "1.74.0",
    "@ivory-tower/n5-shell": "0.1.0",
    "@theia/editor": "1.74.0",
    "@theia/monaco": "1.74.0",
    "@theia/navigator": "1.74.0",
    "@theia/terminal": "1.74.0",
    "@theia/output": "1.74.0",
    "@theia/markers": "1.74.0",
    "@theia/task": "1.74.0",
    "@theia/variable-resolver": "1.74.0",
    "@theia/plugin-ext": "1.74.0",
    "@theia/plugin-ext-vscode": "1.74.0",
    "@theia/userstorage": "1.74.0"
  },
  "scripts": {
    "clean": "theiaext clean",
    "build": "theiaext build && npm run -s bundle",
    "build:production": "theiaext build && npm run -s bundle:production",
    "bundle": "npm run rebuild && theia build --mode development",
    "bundle:production": "npm run rebuild && theia build --mode production",
    "compile": "tsc -b",
    "rebuild": "theia rebuild:browser --cacheRoot ../..",
    "start": "theia start --hostname=127.0.0.1 --port=3107 --plugins=local-dir:./plugins",
    "watch": "concurrently --kill-others -n tsc,bundle -c red,yellow \"tsc -b -w --preserveWatchOutput\" \"npm run -s watch:bundle\"",
    "watch:bundle": "theia build --watch --mode development",
    "prestart": "node ../../scripts/n5/extensions.mjs verify",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@theia/cli": "1.74.0"
  }
}
